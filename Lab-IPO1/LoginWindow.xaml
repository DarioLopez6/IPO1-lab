<Window x:Class="Lab_IPO1.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Login - HomeMade TPV"
        Height="500" Width="400"
        Background="White"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TÍTULO + AYUDA -->
        <DockPanel Grid.Row="0">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                <Image Source="/imagenes/iconoTPV.png" Height="38" Margin="0 0 8 0"/>
                <TextBlock Text="HomeMade" FontSize="26" FontWeight="Bold" VerticalAlignment="Center" Foreground="#2D2D2D"/>
            </StackPanel>

            <Button DockPanel.Dock="Right" Padding="15,5" Cursor="Hand" Width="80" HorizontalAlignment="Right"
                    FocusVisualStyle="{x:Null}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="#F0F0F0" BorderBrush="LightGray" BorderThickness="2" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
                <StackPanel Orientation="Horizontal">
                    <Image Source="/imagenes/help.png" Height="18" Margin="0 0 6 0"/>
                    <TextBlock Text="Ayuda" Foreground="#333"/>
                </StackPanel>
            </Button>
        </DockPanel>

        <!-- Descripción pequeña -->
        <TextBlock Grid.Row="1" Text="Accede para gestionar pedidos, productos y clientes"
                   Foreground="#888" FontSize="12" Margin="2 5 0 15"/>

        <!-- Subtítulo -->
        <StackPanel Grid.Row="2">
            <TextBlock Text="Inicio de sesión" FontSize="19" FontWeight="Bold" Margin="0 0 0 4"/>
            <TextBlock Text="Introduce tu usuario y contraseña del gestor TPV."
                       Foreground="#999" FontSize="12" Margin="0 0 0 25"/>
        </StackPanel>

        <!-- Campos de login -->
        <StackPanel Grid.Row="3" Margin="0">

            <!-- Usuario -->
            <TextBlock Text="Usuario" Foreground="#666" FontSize="14" Margin="0 0 0 3"/>
            <Border x:Name="BorderUsuario" CornerRadius="10" BorderBrush="#CCCCCC" BorderThickness="1" Padding="8" Background="#FAFAFA" Margin="0 0 0 5">
                <DockPanel>
                    <Image x:Name="ImgUsuarioIcon" Source="/imagenes/logo.png" Height="18" Width="18" Margin="0 0 8 0"/>
                    <TextBox x:Name="TxtUsuario" Background="Transparent" BorderThickness="0" Foreground="#333"
                             FontSize="14" VerticalContentAlignment="Center"
                             KeyDown="TxtUsuario_KeyDown" Width="316"/>
                </DockPanel>
            </Border>

            <!-- Contraseña -->
            <Grid Margin="0 0 0 3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Contraseña" Foreground="#666" FontSize="14" Grid.Column="0"/>
                <TextBlock Text="Recuperar contraseña" Foreground="#999" FontSize="12" TextDecorations="Underline"
                           Cursor="Hand" Grid.Column="1"/>
            </Grid>

            <!-- PasswordBox + TextBox visible + Botón ojo -->
            <Border x:Name="BorderContrasena" CornerRadius="10" BorderBrush="#CCCCCC" BorderThickness="1" Padding="0" Background="#FAFAFA" Margin="0 0 0 5" Height="34">
                <Grid>
                    <Image x:Name="imgContrasena" Source="/imagenes/logo.png" Height="18" Width="18" Margin="8 0 8 0" HorizontalAlignment="Left"/>
                    <PasswordBox x:Name="PwdBox" Background="Transparent" BorderThickness="0" Foreground="#333"
                                 FontSize="14" VerticalContentAlignment="Center" Padding="8,0,30,0"
                                 Margin="31,0,0,0" KeyDown="PwdBox_KeyDown" IsEnabled="False"/>
                    <TextBox x:Name="TxtPasswordVisible" Background="Transparent" BorderThickness="0" Foreground="#333"
                             FontSize="14" VerticalContentAlignment="Center" Padding="30,0,0,0" Visibility="Collapsed"/>
                    <Image x:Name="ojo" Source="/imagenes/logo.png" Height="18" Width="18" HorizontalAlignment="Right" Margin="30,0,0,0"/>
                    <Button x:Name="BtnShowPassword" Width="24" Height="24" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Background="Transparent" BorderBrush="Transparent" Cursor="Hand" FocusVisualStyle="{x:Null}" Click="BtnShowPassword_Click"/>
                </Grid>
            </Border>

            <!-- Recordar sesión -->
            <CheckBox Content="Mantener sesión iniciada en este equipo" Foreground="#666" Margin="0 0 0 18" Width="241" HorizontalAlignment="Left"/>
        </StackPanel>

        <!-- Autoría + Acceder -->
        <DockPanel Grid.Row="4" LastChildFill="False" Margin="0,20,0,0">
            <TextBlock Text="Autoría - v1.0" Foreground="#999" FontSize="12" TextDecorations="Underline"
                       VerticalAlignment="Bottom" Cursor="Hand" DockPanel.Dock="Left"/>
            <Button x:Name="BtnAcceder" Padding="10,8" Cursor="Hand" Width="110" DockPanel.Dock="Right" Height="42"
                    Click="BtnAcceder_Click" FocusVisualStyle="{x:Null}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="#FF6B35" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Image Source="/imagenes/logo.png" Height="18" Width="18" Margin="0 0 6 0"/>
                    <TextBlock Text="Acceder" Foreground="White" FontWeight="Bold"/>
                </StackPanel>
            </Button>
        </DockPanel>
    </Grid>
</Window>
