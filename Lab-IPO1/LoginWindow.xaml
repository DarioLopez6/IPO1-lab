<Window x:Class="Lab_IPO1.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Login - HomeMade TPV"
        Height="500" Width="400"
        Background="White"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Window.Resources>

        <!-- Estilo para PasswordBox -->
        <Style TargetType="PasswordBox" x:Key="LoginPasswordStyle">
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Cursor" Value="IBeam"/>
            <Setter Property="Background" Value="White"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="#999999"/>
                    <Setter Property="Background" Value="#F0F0F0"/>
                    <Setter Property="Cursor" Value="No"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Estilo para TextBox visible -->
        <Style TargetType="TextBox" x:Key="LoginTextStyle">
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Cursor" Value="IBeam"/>
            <Setter Property="Background" Value="White"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="#999999"/>
                    <Setter Property="Background" Value="#F0F0F0"/>
                    <Setter Property="Cursor" Value="No"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TÍTULO + AYUDA -->
        <DockPanel Grid.Row="0">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                <Image Source="/imagenes/iconoTPV.png" ToolTip="Mejor restaurante de comida casera" Height="38" Margin="0 0 8 0"/>
                <TextBlock Text="HomeMade" FontSize="26" ToolTip="Mejor restaurante de comida casera" FontWeight="Bold" VerticalAlignment="Center" Foreground="#2D2D2D"/>
            </StackPanel>

            <Button DockPanel.Dock="Right" Padding="15,5" Cursor="Hand" Width="80" HorizontalAlignment="Right"
                    FocusVisualStyle="{x:Null}" ToolTip="Pulsar si necesitas ayuda" Click="BtnAyuda_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="#F0F0F0" BorderBrush="LightGray" BorderThickness="2" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
                <StackPanel Orientation="Horizontal">
                    <Image Source="/imagenes/help.png" Height="18" Margin="0 0 6 0"/>
                    <TextBlock Text="Ayuda" Foreground="#333"/>
                </StackPanel>
            </Button>
        </DockPanel>

        <!-- Descripción pequeña -->
        <TextBlock Grid.Row="1" Text="Accede para gestionar pedidos, productos y clientes"
                   Foreground="#888" FontSize="12" Margin="2 5 0 15"/>

        <!-- Subtítulo -->
        <StackPanel Grid.Row="2">
            <TextBlock Text="Inicio de sesión" FontSize="19" FontWeight="Bold" Margin="0 0 0 4"/>
            <TextBlock Text="Introduce tu usuario y contraseña del gestor TPV."
                       Foreground="#999" FontSize="12" Margin="0 0 0 25"/>
        </StackPanel>

        <!-- Campos de login -->
        <StackPanel Grid.Row="3" Margin="0">

            <!-- Usuario -->
            <Grid Height="21">
                <TextBlock Text="Usuario" Foreground="#666" FontSize="14"/>
                <TextBlock x:Name="txterrorUsuario"
                   Text="Usuario incorrecto"
                   Margin="70,0,0,0"
                   Foreground="Red"
                   FontWeight="Bold"
                   VerticalAlignment="Center"
                   Visibility="Hidden"/>
            </Grid>

            <!-- Caja de Usuario -->
            <Border x:Name="BorderUsuario"
            ToolTip="Escribe el nombre de usuario que tienes asignado"
            CornerRadius="10"
            BorderBrush="#CCCCCC"
            BorderThickness="1"
            Padding="8"
            Background="#FAFAFA"
            Margin="0 0 0 10">

                <DockPanel>
                    <Image x:Name="ImgUsuarioIcon" Source="/imagenes/usuarioIcono.png"
                   Height="18" Width="18"
                   Margin="0 0 8 0"/>

                    <TextBox x:Name="TxtUsuario"
                     Background="Transparent"
                     BorderThickness="0"
                     Foreground="#333"
                     FontSize="14"
                     VerticalContentAlignment="Center"
                     KeyDown="TxtUsuario_KeyDown"
                     Width="316"/>
                </DockPanel>
            </Border>

            <!-- Etiqueta "Contraseña" + Recuperar -->
            <Grid Height="21" Margin="0 0 0 3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Contraseña"
                   Foreground="#666"
                   FontSize="14"/>

                <TextBlock x:Name="txterrorContrasena"
                   Text="Contraseña incorrecta"
                   Foreground="Red"
                   FontWeight="Bold"
                   VerticalAlignment="Center"
                   Margin="92,0,18,0"
                   Grid.ColumnSpan="2" Visibility="Hidden"/>

                <TextBlock Text="Recuperar contraseña"
                   Foreground="#999"
                   FontSize="12"
                   TextDecorations="Underline"
                   Cursor="Hand"
                   Grid.Column="1"
                   MouseLeftButtonUp="BtnRecuperar_Click"/>
            </Grid>

            <!-- Caja de Contraseña -->
            <Border x:Name="BorderContrasena"
            ToolTip="Escribe la contraseña que tienes asignada"
            CornerRadius="10"
            BorderBrush="#CCCCCC"
            BorderThickness="1"
            Background="#F0F0F0"
            Margin="0 0 0 15"
            Height="36">

                <Grid>
                    <!-- Icono -->
                    <Image x:Name="imgContrasena" Source="/imagenes/contrasenaIcono.png"
                   Height="18"
                   Width="18"
                   Margin="8 0 0 0"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Left"/>

                    <!-- PasswordBox -->
                    <PasswordBox x:Name="PwdBox"
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="#333"
                         FontSize="14"
                         VerticalContentAlignment="Center"
                         Margin="32,0,35,0"
                         KeyDown="TxtContrasena_KeyDown"
                         IsEnabled="False"/>

                    <!-- TextBox visible -->
                    <TextBox x:Name="TxtPasswordVisible"
                     Background="Transparent"
                     BorderThickness="0"
                     Foreground="#333"
                     FontSize="14"
                     VerticalContentAlignment="Center"
                     Margin="32,0,35,0"
                     Visibility="Collapsed"
                     KeyDown="TxtContrasena_KeyDown"
                     IsEnabled="False"/>

                    <!-- Botón ojo + icono -->
                    <Image x:Name="ojo"
                   Source="/imagenes/ojoOff.png"
                   Height="18"
                   Width="18"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Right"
                   Margin="0 0 10 0"/>

                    <Button x:Name="BtnShowPassword"
                    Width="30"
                    Height="30"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    Cursor="Hand"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Margin="0 0 5 0"
                    Click="BtnShowPassword_Click"/>
                </Grid>
            </Border>

            <!-- Checkbox recordar -->
            <CheckBox Content="Mantener sesión iniciada en este equipo"
              ToolTip="Activa si no quieres cerrar sesión al cerrar la App"
              Foreground="#666"
              Margin="0 0 0 18"
              Width="250"
              HorizontalAlignment="Left"/>

        </StackPanel>


        <!-- Autoría + Acceder -->
        <DockPanel Grid.Row="4" LastChildFill="False" Margin="0,20,0,0">
            <TextBlock Text="Autoría - v1.0" Cursor="Hand" Foreground="#999" FontSize="12" TextDecorations="Underline"
                       VerticalAlignment="Bottom" DockPanel.Dock="Left" MouseLeftButtonUp="Btnautoria_Click"/>
            <Button x:Name="BtnAcceder" Padding="10,8" Cursor="Hand" ToolTip="Acceder a la aplicación" Width="110" DockPanel.Dock="Right" Height="42"
                    Click="BtnAcceder_Click" FocusVisualStyle="{x:Null}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="#FF6B35" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Image Source="/imagenes/cobrarIcon.png" Height="18" Width="18" Margin="0 0 6 0"/>
                    <TextBlock Text="Acceder" Foreground="White" FontWeight="Bold"/>
                </StackPanel>
            </Button>
        </DockPanel>
    </Grid>
</Window>
