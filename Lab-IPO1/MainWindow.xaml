<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:av="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="av" x:Class="Lab_IPO1.MainWindow"
    WindowState="Maximized"
        MinWidth="1200" MinHeight="800"
    WindowStartupLocation="CenterScreen"
        Title="HomeMade TPV" Height="759" Width="1200">
    <Window.Resources>

        <!-- TARJETA DE PRODUCTO -->
        <Style x:Key="ProductoCardStyle" TargetType="{x:Type Border}">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="BorderBrush" Value="#DDDDDD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="0 5"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <!-- RADIOBUTTON COMO BOTÓN -->
        <Style x:Key="RadioButtonButtonStyle" TargetType="{x:Type RadioButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RadioButton}">
                        <Border x:Name="Border"
                            CornerRadius="10"
                            BorderThickness="1"
                            BorderBrush="#CCCCCC"
                            Background="LightGray"
                            Padding="8"
                            Margin="2">
                            <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>

                            <!-- SELECCIONADO -->
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#FFFF6B35"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="#CC5500"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>

                            <!-- HOVER -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#FFE6E6E6"/>
                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <DockPanel Background="LightGray">

        <!-- ─────────────────────────────── -->
        <!-- BARRA SUPERIOR                 -->
        <!-- ─────────────────────────────── -->

        <Border DockPanel.Dock="Top"
        Background="#FFFFFF"
        Padding="12"
        BorderBrush="#CCCCCC"
        BorderThickness="0,0,0,1">

            <DockPanel>

                <!-- LOGO IZQUIERDA -->
                <Button DockPanel.Dock="Left"
                Background="Transparent"
                BorderBrush="Transparent"
                Padding="0"
                Margin="5 0"
                FocusVisualStyle="{x:Null}">

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" ToolTip="Mejor restaurante de comida casera">
                        <Image Source="/imagenes/iconoTPV.png" Height="30" Margin="0 0 8 0"/>
                        <TextBlock x:Name="txtlogo" Text="HomeMade TPV"
                           FontSize="22"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           Foreground="#2D2D2D"/>
                    </StackPanel>
                </Button>

                <!-- BOTONES DERECHA -->
                <StackPanel DockPanel.Dock="Right"
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Right">

                    <!-- BOTÓN AYUDA -->
                    <Button Padding="15,5" Margin="5" Cursor="Hand" Width="81" Click="Button_Click_1" >
                        <Button.Template>

                            <ControlTemplate TargetType="{x:Type Button}">
                                <Border Background="#F0F0F0" 
                                BorderBrush="LightGray" 
                                BorderThickness="2" 
                                CornerRadius="10">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Image Source="imagenes/help.png" Height="18" Margin="0 0 6 0"/>
                            <TextBlock Text="Ayuda" VerticalAlignment="Center" Foreground="#333"/>
                        </StackPanel>
                    </Button>

                    <!-- BOTÓN NUEVO PEDIDO -->
                    <Button Padding="15,5" Margin="5" Cursor="Hand" Width="126" Click="Button_Click_3">
                        <Button.Template>
                            <ControlTemplate TargetType="{x:Type Button}">
                                <Border Background="#FFFF6B35" 
                                    BorderBrush="LightGray" 
                                    BorderThickness="2" 
                                    CornerRadius="10">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Image Source="imagenes/nuevoPedido.png" Height="18" Margin="0 0 6 0"/>
                            <TextBlock Text="Nuevo Pedido" VerticalAlignment="Center" Foreground="White"/>
                        </StackPanel>
                    </Button>

                    <!-- BOTÓN PERFIL -->
                    <Button Padding="15,5" Margin="5" Width="226">
                        <Button.Template>
                            <ControlTemplate TargetType="{x:Type Button}">
                                <Border Background="#E8E8E8" 
                                BorderBrush="LightGray" 
                                BorderThickness="2" 
                                CornerRadius="10">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Width="214" Height="37">
                            <Border CornerRadius="50" Width="30" Height="30" ClipToBounds="True" Margin="0 0 8 0">
                                <Image Source="imagenes/perfil.png" Stretch="Fill" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                            </Border>
                            <StackPanel>
                                <TextBlock FontSize="14" Foreground="#222" HorizontalAlignment="Center"><Run Language="es-es" Text="admin"/></TextBlock>
                                <TextBlock FontSize="11" Foreground="#555" HorizontalAlignment="Right"><Run Text="Último acceso: "/><Run Language="es-es" Text=" "/><Run Text="ahora mismo"/></TextBlock>
                            </StackPanel>
                        </StackPanel>
                    </Button>

                    <!-- BOTÓN CERRAR SESIÓN -->
                    <Button Padding="15,5" Margin="5" Cursor="Hand" Width="106" Click="Button_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="{x:Type Button}">
                                <Border Background="#FFFFFF" 
                                BorderBrush="LightGray" 
                                BorderThickness="2" 
                                CornerRadius="10">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Image Source="imagenes/logout.png" Height="18" Margin="0 0 6 0"/>
                            <TextBlock Text="Cerrar sesión" VerticalAlignment="Center" Foreground="#333"/>
                        </StackPanel>
                    </Button>

                </StackPanel>

            </DockPanel>

        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <!-- Para el TabControl -->
                <ColumnDefinition Width="auto"/>
                <!-- Para el Border de Pedido Actual -->
            </Grid.ColumnDefinitions>

            <!-- ─────────────────────────────── -->
            <!-- TABCONTROL OCUPA EL RESTO      -->
            <!-- ─────────────────────────────── -->
            <TabControl x:Name="MainTabControl"
                TabStripPlacement="Left" Grid.Column="0"
                SelectionChanged="MainTabControl_SelectionChanged"
                BorderThickness="1" Background="#FFFFFF">

                <!-- TAB PRODUCTOS -->
                <TabItem x:Name="TabProductos" Background="Transparent">
                    <TabItem.Header>
                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                            <Image x:Name="ImgProductos" Height="64" Source="/imagenes/menuProductosOn.png"/>
                        </StackPanel>
                    </TabItem.Header>
                    <Grid Background="#FFFFFF" Margin="0,0,-12,0">
                        <!-- ================================ -->
                        <!--        BARRA SUPERIOR           -->
                        <!-- ================================ -->
                        <Border Background="#FFFFFF" Padding="15" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1">
                            <Grid Margin="0,0,0,-6">

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <!-- Título -->
                                    <RowDefinition Height="Auto" MinHeight="57"/>
                                    <RowDefinition Height="50*"/>
                                    <RowDefinition Height="47*"/>
                                    <RowDefinition Height="417*"/>
                                    <!-- Barra inferior -->
                                </Grid.RowDefinitions>

                                <!-- ========================= -->
                                <!-- TÍTULO - ARRIBA IZQUIERDA -->
                                <!-- ========================= -->
                                <Grid Margin="0,0,21,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="35*"/>
                                        <ColumnDefinition Width="8*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Platos"
                                      FontSize="22"
                                      FontWeight="Bold"
                                      Margin="0 0 0 10"
                                      HorizontalAlignment="Left"
                                      Grid.Row="0" Width="63"/>
                                    <Border
                                        CornerRadius="10"
                                        BorderBrush="#FF7F00"
                                        BorderThickness="2"
                                        Background="#FF7F00" Margin="1,0,0,0" Grid.Column="1">
                                        <Button Content="Crear Plato"
                                            Padding="10,5"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Foreground="White"
                                            FontWeight="Bold"
                                            FontSize="14"
                                            Cursor="Hand"
                                            Click="BtnCrearPlato_Click" Margin="-2,0,0,0"/>
                                    </Border>

                                </Grid>
                                <!-- ========================= -->


                                <!-- ========================= -->
                                <Grid Margin="0,39,0,0" Grid.RowSpan="2">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <!-- Izquierda -->
                                        <ColumnDefinition Width="Auto" />
                                        <!-- Derecha -->
                                    </Grid.ColumnDefinitions>


                                    <!-- IZQUIERDA: Buscador + Filtro -->
                                    <StackPanel Orientation="Horizontal"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Left"
                   Grid.Column="0" Width="481">

                                        <!-- Buscador con icono -->
                                        <DockPanel Background="#F5F5F5"
                      Height="32" Width="481"
                      LastChildFill="True"
                      Margin="0 0 10 0">

                                            <Image Source="/imagenes/logo.png"
                          Width="18" Height="18"
                          Margin="5,0"
                          VerticalAlignment="Center"/>

                                            <TextBox x:Name="TxtBuscarPlato"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="10,0"
                        FontSize="14" VerticalAlignment="Center"/>
                                        </DockPanel>
                                    </StackPanel>

                                </Grid>
                                <!-- Fila principal de categorías -->
                                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,57,0,0" Grid.RowSpan="2">
                                    <RadioButton x:Name="btnEntrantes" Style="{StaticResource RadioButtonButtonStyle}" Content="Entrantes" GroupName="TipoPlatos" Width="80"/>
                                    <RadioButton x:Name="btnPrimeros" Style="{StaticResource RadioButtonButtonStyle}" Content="Primeros" GroupName="TipoPlatos" Width="80"/>
                                    <RadioButton x:Name="btnSegundos" Style="{StaticResource RadioButtonButtonStyle}" Content="Segundos" GroupName="TipoPlatos" Width="80"/>
                                    <RadioButton x:Name="btnPostres" Style="{StaticResource RadioButtonButtonStyle}" Content="Postres" GroupName="TipoPlatos" Width="80"/>
                                    <RadioButton x:Name="btnBebidas" Style="{StaticResource RadioButtonButtonStyle}" Content="Bebidas" GroupName="TipoPlatos" Width="80"/>
                                    <RadioButton x:Name="btnSinFiltro" Style="{StaticResource RadioButtonButtonStyle}" Content="Sin filtro" GroupName="TipoPlatos" Width="90"/>
                                </StackPanel>

                                <!-- Fila secundaria: subcategorías -->
                                <StackPanel x:Name="FilaSegundaCategoria" Grid.Row="3" Orientation="Horizontal" Margin="0,10,0,0" Visibility="Collapsed">
                                    <RadioButton x:Name="btnEnsaladas" Style="{StaticResource RadioButtonButtonStyle}" Content="Ensaladas" GroupName="SubTipoPlatos" Width="70" FontSize="12"/>
                                    <RadioButton x:Name="btnHuevos" Style="{StaticResource RadioButtonButtonStyle}" Content="Carnes" GroupName="SubTipoPlatos" Width="70" FontSize="12"/>
                                    <RadioButton x:Name="btnArrocesYPastas" Style="{StaticResource RadioButtonButtonStyle}" Content="Arroces y Pastas" GroupName="SubTipoPlatos" Width="115" FontSize="12"/>
                                    <RadioButton x:Name="btnPescados" Style="{StaticResource RadioButtonButtonStyle}" Content="Pescados" GroupName="SubTipoPlatos" Width="80" FontSize="12"/>
                                    <RadioButton x:Name="btnSinFiltro2" Style="{StaticResource RadioButtonButtonStyle}" Content="Sin filtro" GroupName="SubTipoPlatos" Width="80" FontSize="12"/>
                                </StackPanel>

                                <Border BorderBrush="Gray" Background="#00808080" Grid.Row="4" CornerRadius="20">
                                    <ListView x:Name="PlatosListView" 
                                              ItemsSource="{Binding Platos}"
                                              SelectionChanged="PlatosListView_SelectionChanged"
                                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                              ScrollViewer.VerticalScrollBarVisibility="Auto" Background="#00E2E2E2">

                                        <!-- WrapPanel para organizar items en varias columnas -->
                                        <ListView.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal" IsItemsHost="True"/>
                                            </ItemsPanelTemplate>
                                        </ListView.ItemsPanel>

                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#F5F5F5"       
                                                    CornerRadius="12"
                Padding="10"
                Margin="8"
                Width="260"
                BorderBrush="#FFFF6B35"
                BorderThickness="1"
                SnapsToDevicePixels="True">

                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="130"/>
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Imagen -->
                                                        <Border Grid.Column="0" CornerRadius="10" ClipToBounds="True">
                                                            <Image Source="{Binding Imagen}" 
                           Width="120" Height="100" 
                           Stretch="UniformToFill"/>
                                                        </Border>

                                                        <!-- Contenido -->
                                                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Top">
                                                            <!-- Nombre del plato -->
                                                            <TextBlock Text="{Binding Nombre}" 
                               FontWeight="Bold" 
                               FontSize="16" 
                               Foreground="#333"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="NoWrap"/>

                                                            <!-- Ingredientes -->
                                                            <TextBlock Text="{Binding Ingredientes}" 
                               FontSize="13" 
                               Foreground="#666"
                               TextWrapping="Wrap" 
                               TextTrimming="CharacterEllipsis"
                               MaxHeight="32"   
                               Margin="0,4,0,6"/>

                                                            <!-- Alérgenos -->
                                                            <ItemsControl ItemsSource="{Binding ListaAlergenos}">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <WrapPanel />
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Border Background="#FFE5B4"  
                                        CornerRadius="10"
                                        Padding="4,2"
                                        Margin="2">
                                                                            <TextBlock Text="{Binding}" 
                                               FontSize="11" 
                                               Foreground="#333"
                                               TextTrimming="CharacterEllipsis"/>
                                                                        </Border>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>

                                                            <Border CornerRadius="8" Background="#FFFF6B35" HorizontalAlignment="Right">
                                                                <Button Padding="5,2"
                                                                    Background="Transparent"
                                                                    Foreground="White"
                                                                    FontWeight="Bold"
                                                                    Cursor="Hand"
                                                                    BorderThickness="0"
                                                                    ToolTip="Ver detalles, modificar o eliminar este plato"
                                                                    Click="BtnInformacion_Click">
                                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                        <!-- Icono de información -->
                                                                        <TextBlock Text="ℹ" FontSize="14" Margin="0,0,5,0"/>
                                                                        <TextBlock Text="Detalles" FontSize="14"/>
                                                                    </StackPanel>
                                                                </Button>
                                                            </Border>

                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>

                                    </ListView>

                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- TAB PEDIDOS -->
                <TabItem x:Name="TabPedidos" Background="Transparent">
                    <TabItem.Header>
                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                            <Image x:Name="ImgPedidos" Height="64" Source="/imagenes/menuPedidosOff.png"/>
                        </StackPanel>
                    </TabItem.Header>

                    <Grid Background="#FFFFFF">
                        <!-- Barra superior -->
                        <Border Padding="15" BorderThickness="0,0,0,1" BorderBrush="#DDDDDD" Background="#FFFFFF">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Text="Gestión de Pedidos" FontSize="22" FontWeight="Bold" Margin="0,0,0,10"/>

                                <Grid Grid.Row="1" Height="40">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Buscador + Combo -->
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Grid.Column="0">
                                        <DockPanel Width="220" Height="32" Background="#F5F5F5" Margin="0,0,10,0">
                                            <Image Width="18" Height="18" Margin="5,0" VerticalAlignment="Center" Source="/imagenes/logo.png"/>
                                            <TextBox x:Name="txtBuscador" TextChanged="txtBuscador_TextChanged" BorderThickness="0" Background="Transparent" Padding="10,0" FontSize="14" VerticalAlignment="Center"/>
                                        </DockPanel>

                                        <ComboBox x:Name="cmbFiltroPedido" Width="140" SelectedItem="0"
          SelectionChanged="cmbFiltroPedido_SelectionChanged">
                                            <ComboBoxItem Content="Todos" IsSelected="True"/>
                                            <ComboBoxItem Content="Local"/>
                                            <ComboBoxItem Content="Teléfono"/>
                                        </ComboBox>

                                        <ComboBox x:Name="cmbFiltroPago" Width="140" SelectedItem="0"
                                            SelectionChanged="cmbFiltroPago_SelectionChanged">
                                            <ComboBoxItem Content="Todos" IsSelected="True"/>
                                            <ComboBoxItem Content="Tarjeta"/>
                                            <ComboBoxItem Content="Efectivo"/>
                                            <ComboBoxItem Content="Bizum"/>
                                        </ComboBox>

                                    </StackPanel>

                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Fases scroll horizontal -->
                        <ScrollViewer Margin="10,125,10,10" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" PanningMode="HorizontalOnly">
                            <StackPanel Orientation="Horizontal">
                                <!-- PENDIENTES -->
                                <Border Width="320" Padding="12" Margin="0,0,20,0" CornerRadius="12" BorderBrush="#CCCCCC" BorderThickness="1" Background="#FAFAFA">
                                    <DockPanel>
                                        <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Pendientes de pago" FontSize="18" FontWeight="Bold"/>
                                            <Border Grid.Column="1" Background="#FF6B35" CornerRadius="10" Padding="8,2">
                                                <TextBlock Text="0" x:Name="txtNumPendientes" Foreground="White" FontWeight="Bold"/>
                                            </Border>
                                        </Grid>
                                        <ScrollViewer Height="419" VerticalScrollBarVisibility="Auto">
                                            <StackPanel x:Name="listaPendientesPago"/>
                                        </ScrollViewer>
                                    </DockPanel>
                                </Border>

                                <!-- EN ELABORACIÓN -->
                                <Border Width="320" Padding="12" Margin="0,0,20,0" CornerRadius="12" BorderBrush="#CCCCCC" BorderThickness="1" Background="#FAFAFA">
                                    <DockPanel>
                                        <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="En elaboración" FontSize="18" FontWeight="Bold"/>
                                            <Border Grid.Column="1" Background="#FF6B35" CornerRadius="10" Padding="8,2">
                                                <TextBlock Text="0" x:Name="txtNumEnElaboracion" Foreground="White" FontWeight="Bold"/>
                                            </Border>
                                        </Grid>
                                        <ScrollViewer Height="419" VerticalScrollBarVisibility="Auto">
                                            <StackPanel x:Name="listaEnElaboracion"/>
                                        </ScrollViewer>
                                    </DockPanel>
                                </Border>

                                <!-- LISTOS -->
                                <Border Width="320" Padding="12" Margin="0,0,20,0" CornerRadius="12" BorderBrush="#CCCCCC" BorderThickness="1" Background="#FAFAFA">
                                    <DockPanel>
                                        <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Listos para entregar" FontSize="18" FontWeight="Bold"/>
                                            <Border Grid.Column="1" Background="#FF6B35" CornerRadius="10" Padding="8,2">
                                                <TextBlock Text="0" x:Name="txtNumListos" Foreground="White" FontWeight="Bold"/>
                                            </Border>
                                        </Grid>
                                        <ScrollViewer Height="420" VerticalScrollBarVisibility="Auto">
                                            <StackPanel x:Name="listaListos"/>
                                        </ScrollViewer>
                                    </DockPanel>
                                </Border>

                                <!-- HISTORIAL -->
                                <Border Width="320" Padding="12" CornerRadius="12" BorderBrush="#CCCCCC" BorderThickness="1" Background="#FAFAFA">
                                    <DockPanel>
                                        <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Historial" FontSize="18" FontWeight="Bold"/>
                                            <Border Grid.Column="1" Background="#FF6B35" CornerRadius="10" Padding="8,2">
                                                <TextBlock Text="0" x:Name="txtNumHistorial" Foreground="White" FontWeight="Bold"/>
                                            </Border>
                                        </Grid>
                                        <ScrollViewer Height="420" VerticalScrollBarVisibility="Auto">
                                            <StackPanel x:Name="listaHistorial"/>
                                        </ScrollViewer>
                                    </DockPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                    </Grid>
                </TabItem>

                <!-- TAB CLIENTES -->
                <TabItem x:Name="TabClientes" Background="Transparent">
                    <TabItem.Header>
                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                            <Image x:Name="ImgClientes" Height="64" Source="/imagenes/menuClientesOff.png"/>
                        </StackPanel>
                    </TabItem.Header>
                    <Grid Background="#FFFFFF" Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="69"/>
                            <RowDefinition Height="173"/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>


                        <!-- ===================== -->
                        <!--       PARTE ARRIBA    -->
                        <!-- ===================== -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="579*"/>
                                <ColumnDefinition Width="128*"/>
                            </Grid.ColumnDefinitions>
                            <Border Background="#F0F0F0"
        CornerRadius="10"
        Padding="8"
        Margin="10,12,28,15"
        Height="42">

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Icono -->
                                    <Image Source="imagenes/usuarioIcono.png"
               Height="22"
               Width="25"
               Margin="0,0,6,0"
               VerticalAlignment="Center"/>

                                    <!-- Buscador -->
                                    <TextBox x:Name="BuscadorClientes"
                 Grid.Column="1"
                 Height="26"
                 Background="Transparent"
                 BorderThickness="0"
                 VerticalAlignment="Center"
                 HorizontalAlignment="Stretch"
                 FontSize="14" TextChanged="BuscadorClientes_TextChanged"/>
                                </Grid>
                            </Border>

                            <Button x:Name="btnanadirCliente" Padding="15,5" Cursor="Hand" Width="135" Height="47" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,-7,0" Grid.ColumnSpan="2" Click="btnanadirCliente_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="{x:Type Button}">
                                        <Border Background="#FFFF6B35" 
                                BorderBrush="LightGray" 
                                BorderThickness="2" 
                                CornerRadius="10">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Image Source="imagenes/usuarioIcono.png" Height="18" Margin="0 0 6 0"/>
                                    <TextBlock Text="Añadir Cliente" VerticalAlignment="Center" Foreground="White"/>
                                </StackPanel>
                            </Button>
                        </Grid>



                        <Border Margin="10,10,10,10" Grid.Row="1"
        Padding="15"
        Background="#F5F5F5"
        CornerRadius="12"
        BorderBrush="#D0D0D0"
        BorderThickness="1">

                            <Grid>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="24*"/>
                                    <RowDefinition Height="97*"/>
                                </Grid.RowDefinitions>

                                <!-- CABECERA -->
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>

                                    <!-- TÍTULO -->
                                    <TextBlock Text="Clientes"
                       FontSize="18"
                       FontWeight="Bold"
                       VerticalAlignment="Center"/>

                                    <!-- SUBTÍTULO A LA DERECHA -->
                                    <TextBlock x:Name="TxtTotalClientes"
                       Grid.Column="1"
