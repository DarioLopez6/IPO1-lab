<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:av="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="av" x:Class="Lab_IPO1.MainWindow"
        MinWidth="1200" MinHeight="733"
        Title="HomeMade TPV" Height="733" Width="1200">
    <Window.Resources>

        <!-- TARJETA DE PRODUCTO -->
        <Style x:Key="ProductoCardStyle" TargetType="{x:Type Border}">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="BorderBrush" Value="#DDDDDD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="0 5"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <!-- RADIOBUTTON COMO BOTÓN -->
        <Style x:Key="RadioButtonButtonStyle" TargetType="{x:Type RadioButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RadioButton}">
                        <Border x:Name="Border"
                            CornerRadius="10"
                            BorderThickness="1"
                            BorderBrush="#CCCCCC"
                            Background="LightGray"
                            Padding="8"
                            Margin="2">
                            <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>

                            <!-- SELECCIONADO -->
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#FFFF6B35"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="#CC5500"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>

                            <!-- HOVER -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#FFE6E6E6"/>
                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <DockPanel Background="LightGray">

        <!-- ─────────────────────────────── -->
        <!-- BARRA SUPERIOR                 -->
        <!-- ─────────────────────────────── -->
        <Border DockPanel.Dock="Top"
        Background="#FFFFFF"
        Padding="12"
        BorderBrush="#CCCCCC"
        BorderThickness="0,0,0,1">

            <DockPanel>

                <!-- LOGO IZQUIERDA -->
                <Button DockPanel.Dock="Left"
                Background="Transparent"
                BorderBrush="Transparent"
                Padding="0"
                Margin="5 0"
                FocusVisualStyle="{x:Null}">

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" ToolTip="Mejor restaurante de comida casera">
                        <Image Source="/imagenes/iconoTPV.png" Height="30" Margin="0 0 8 0"/>
                        <TextBlock x:Name="txtlogo" Text="HomeMade TPV"
                           FontSize="22"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           Foreground="#2D2D2D"/>
                    </StackPanel>
                </Button>

                <!-- BOTONES DERECHA -->
                <StackPanel DockPanel.Dock="Right"
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Right">

                    <!-- BOTÓN AYUDA -->
                    <Button Padding="15,5" Margin="5" Cursor="Hand" Width="81" Click="Button_Click_1" >
                        <Button.Template>

                            <ControlTemplate TargetType="{x:Type Button}">
                                <Border Background="#F0F0F0" 
                                BorderBrush="LightGray" 
                                BorderThickness="2" 
                                CornerRadius="10">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Image Source="imagenes/help.png" Height="18" Margin="0 0 6 0"/>
                            <TextBlock Text="Ayuda" VerticalAlignment="Center" Foreground="#333"/>
                        </StackPanel>
                    </Button>

                    <!-- BOTÓN NUEVO PEDIDO -->
                    <Button Padding="15,5" Margin="5" Cursor="Hand" Width="126" Click="Button_Click_3">
                        <Button.Template>
                            <ControlTemplate TargetType="{x:Type Button}">
                                <Border Background="#FFFF6B35" 
                                    BorderBrush="LightGray" 
                                    BorderThickness="2" 
                                    CornerRadius="10">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Image Source="imagenes/nuevoPedido.png" Height="18" Margin="0 0 6 0"/>
                            <TextBlock Text="Nuevo Pedido" VerticalAlignment="Center" Foreground="White"/>
                        </StackPanel>
                    </Button>

                    <!-- BOTÓN PERFIL -->
                    <Button Padding="15,5" Margin="5" Width="226">
                        <Button.Template>
                            <ControlTemplate TargetType="{x:Type Button}">
                                <Border Background="#E8E8E8" 
                                BorderBrush="LightGray" 
                                BorderThickness="2" 
                                CornerRadius="10">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Width="214" Height="37">
                            <Border CornerRadius="50" Width="30" Height="30" ClipToBounds="True" Margin="0 0 8 0">
                                <Image Source="imagenes/perfil.png" Stretch="Fill" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                            </Border>
                            <StackPanel>
                                <TextBlock FontSize="14" Foreground="#222" HorizontalAlignment="Center"><Run Language="es-es" Text="admin"/></TextBlock>
                                <TextBlock FontSize="11" Foreground="#555" HorizontalAlignment="Right"><Run Text="Último acceso: "/><Run Language="es-es" Text=" "/><Run Text="ahora mismo"/></TextBlock>
                            </StackPanel>
                        </StackPanel>
                    </Button>

                    <!-- BOTÓN CERRAR SESIÓN -->
                    <Button Padding="15,5" Margin="5" Cursor="Hand" Width="106" Click="Button_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="{x:Type Button}">
                                <Border Background="#FFFFFF" 
                                BorderBrush="LightGray" 
                                BorderThickness="2" 
                                CornerRadius="10">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Image Source="imagenes/logout.png" Height="18" Margin="0 0 6 0"/>
                            <TextBlock Text="Cerrar sesión" VerticalAlignment="Center" Foreground="#333"/>
                        </StackPanel>
                    </Button>

                </StackPanel>

            </DockPanel>

        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <!-- Para el TabControl -->
                <ColumnDefinition Width="auto"/>
                <!-- Para el Border de Pedido Actual -->
            </Grid.ColumnDefinitions>

            <!-- ─────────────────────────────── -->
            <!-- TABCONTROL OCUPA EL RESTO      -->
            <!-- ─────────────────────────────── -->
            <TabControl x:Name="MainTabControl"
                TabStripPlacement="Left" Grid.Column="0"
                SelectionChanged="MainTabControl_SelectionChanged"
                BorderThickness="1" Background="#FFFFFF">

                <!-- TAB PRODUCTOS -->
                <TabItem x:Name="TabProductos" Background="Transparent">
                    <TabItem.Header>
                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                            <Image x:Name="ImgProductos" Height="64" Source="/imagenes/menuProductosOn.png"/>
                        </StackPanel>
                    </TabItem.Header>
                    <Grid Background="#FFFFFF" Margin="0,0,-12,0">
                        <!-- ================================ -->
                        <!--        BARRA SUPERIOR           -->
                        <!-- ================================ -->
                        <Border Background="#FFFFFF" Padding="15" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1">
                            <Grid Margin="0,0,0,-6">

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <!-- Título -->
                                    <RowDefinition Height="Auto" MinHeight="57"/>
                                    <RowDefinition Height="50*"/>
                                    <RowDefinition Height="47*"/>
                                    <RowDefinition Height="417*"/>
                                    <!-- Barra inferior -->
                                </Grid.RowDefinitions>

                                <!-- ========================= -->
                                <!-- TÍTULO - ARRIBA IZQUIERDA -->
                                <!-- ========================= -->
                                <TextBlock Text="Platos"
              FontSize="22"
              FontWeight="Bold"
              Margin="0 0 0 10"
              HorizontalAlignment="Left"
              Grid.Row="0" Width="63"/>


                                <!-- ========================= -->
                                <!-- BARRA INFERIOR (2 columnas) -->
                                <!-- ========================= -->
                                <Grid Margin="0,39,0,0" Grid.RowSpan="2">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <!-- Izquierda -->
                                        <ColumnDefinition Width="Auto" />
                                        <!-- Derecha -->
                                    </Grid.ColumnDefinitions>


                                    <!-- IZQUIERDA: Buscador + Filtro -->
                                    <StackPanel Orientation="Horizontal"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Left"
                   Grid.Column="0">

                                        <!-- Buscador con icono -->
                                        <DockPanel Background="#F5F5F5"
                      Height="32" Width="220"
                      LastChildFill="True"
                      Margin="0 0 10 0">

                                            <Image Source="/imagenes/logo.png"
                          Width="18" Height="18"
                          Margin="5,0"
                          VerticalAlignment="Center"/>

                                            <TextBox x:Name="TxtBuscarPlato"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="10,0"
                        FontSize="14" VerticalAlignment="Center"/>
                                        </DockPanel>
                                    </StackPanel>

                                </Grid>
                                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,57,0,0" Grid.RowSpan="2">
                                    <RadioButton x:Name="btnEntrantes" Style="{StaticResource RadioButtonButtonStyle}"
                Content="Entrantes"
                GroupName="TipoPlatos"
                Width="80" HorizontalAlignment="Left"/>
                                    <RadioButton x:Name="btnPrimeros" Style="{StaticResource RadioButtonButtonStyle}"
                Content="Primeros"
                GroupName="TipoPlatos"
                Width="80" HorizontalAlignment="Left"/>
                                    <RadioButton x:Name="btnSegundos" Style="{StaticResource RadioButtonButtonStyle}"
                Content="Segundos"
                GroupName="TipoPlatos"
                Width="80" HorizontalAlignment="Left"/>
                                    <RadioButton x:Name="btnPostres" Style="{StaticResource RadioButtonButtonStyle}"
                Content="Postres"
                GroupName="TipoPlatos"
                Width="80" HorizontalAlignment="Left"/>
                                    <RadioButton x:Name="btnBebidas" Style="{StaticResource RadioButtonButtonStyle}"
                Content="Bebidas"
                GroupName="TipoPlatos"
                Width="80" HorizontalAlignment="Left"/>
                                </StackPanel>
                                <StackPanel Grid.Row="3" Orientation="Horizontal">
                                    <RadioButton x:Name="btnEnsaladas" Style="{StaticResource RadioButtonButtonStyle}"
                Content="Ensaladas"
                GroupName="TipoPlatos"
                Width="80" HorizontalAlignment="Left"/>
                                    <RadioButton x:Name="btnHuevos" Style="{StaticResource RadioButtonButtonStyle}"
                Content="Huevos"
                GroupName="TipoPlatos"
                Width="80" HorizontalAlignment="Left"/>
                                    <RadioButton x:Name="btnArrocesYPastas" Style="{StaticResource RadioButtonButtonStyle}"
                Content="Arroces y Pastas"
                GroupName="TipoPlatos"
                Width="auto" HorizontalAlignment="Left"/>
                                    <RadioButton x:Name="btnPescados" Style="{StaticResource RadioButtonButtonStyle}"
                Content="Pescados"
                GroupName="TipoPlatos"
                Width="auto" HorizontalAlignment="Left"/>
                                </StackPanel>
                                <Border BorderBrush="Gray" Background="Gray" Grid.Row="4">
                                    <ListView x:Name="PlatosListView" Margin="10" av:ItemsSource="{av:SampleData ItemCount=5}" SelectionChanged="PlatosListView_SelectionChanged">
                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Image Source="{Binding Imagen}"
                                Width="40" Height="40" Margin="5"/>
                                                    <TextBlock Text="{Binding Nombre}"
                                VerticalAlignment="Center"
                                FontSize="16"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- TAB PEDIDOS -->
                <TabItem x:Name="TabPedidos" Background="Transparent">
                    <TabItem.Header>
                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                            <Image x:Name="ImgPedidos" Height="64" Source="/imagenes/menuPedidosOff.png"/>
                        </StackPanel>
                    </TabItem.Header>

                    <Grid Background="#FFFFFF">
                        <!-- Barra superior -->
                        <Border Padding="15" BorderThickness="0,0,0,1" BorderBrush="#DDDDDD" Background="#FFFFFF">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Text="Gestión de Pedidos" FontSize="22" FontWeight="Bold" Margin="0,0,0,10"/>

                                <Grid Grid.Row="1" Height="40">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Buscador + Combo -->
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Grid.Column="0">
                                        <DockPanel Width="220" Height="32" Background="#F5F5F5" Margin="0,0,10,0">
                                            <Image Width="18" Height="18" Margin="5,0" VerticalAlignment="Center" Source="/imagenes/logo.png"/>
                                            <TextBox x:Name="txtBuscador" TextChanged="txtBuscador_TextChanged" BorderThickness="0" Background="Transparent" Padding="10,0" FontSize="14" VerticalAlignment="Center"/>
                                        </DockPanel>

                                        <ComboBox x:Name="cmbFiltroPedido" Width="140" SelectedItem="0"
          SelectionChanged="cmbFiltroPedido_SelectionChanged">
                                            <ComboBoxItem Content="Todos" IsSelected="True"/>
                                            <ComboBoxItem Content="Local"/>
                                            <ComboBoxItem Content="Teléfono"/>
                                        </ComboBox>

                                        <ComboBox x:Name="cmbFiltroPago" Width="140" SelectedItem="0"
                                            SelectionChanged="cmbFiltroPago_SelectionChanged">
                                            <ComboBoxItem Content="Todos" IsSelected="True"/>
                                            <ComboBoxItem Content="Tarjeta"/>
                                            <ComboBoxItem Content="Efectivo"/>
                                            <ComboBoxItem Content="Bizum"/>
                                        </ComboBox>

                                    </StackPanel>

                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Fases scroll horizontal -->
                        <ScrollViewer Margin="10,125,10,10" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" PanningMode="HorizontalOnly">
                            <StackPanel Orientation="Horizontal">
                                <!-- PENDIENTES -->
                                <Border Width="320" Padding="12" Margin="0,0,20,0" CornerRadius="12" BorderBrush="#CCCCCC" BorderThickness="1" Background="#FAFAFA">
                                    <DockPanel>
                                        <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Pendientes de pago" FontSize="18" FontWeight="Bold"/>
                                            <Border Grid.Column="1" Background="#FF6B35" CornerRadius="10" Padding="8,2">
                                                <TextBlock Text="0" x:Name="txtNumPendientes" Foreground="White" FontWeight="Bold"/>
                                            </Border>
                                        </Grid>
                                        <ScrollViewer Height="419" VerticalScrollBarVisibility="Auto">
                                            <StackPanel x:Name="listaPendientesPago"/>
                                        </ScrollViewer>
                                    </DockPanel>
                                </Border>

                                <!-- EN ELABORACIÓN -->
                                <Border Width="320" Padding="12" Margin="0,0,20,0" CornerRadius="12" BorderBrush="#CCCCCC" BorderThickness="1" Background="#FAFAFA">
                                    <DockPanel>
                                        <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="En elaboración" FontSize="18" FontWeight="Bold"/>
                                            <Border Grid.Column="1" Background="#FF6B35" CornerRadius="10" Padding="8,2">
                                                <TextBlock Text="0" x:Name="txtNumEnElaboracion" Foreground="White" FontWeight="Bold"/>
                                            </Border>
                                        </Grid>
                                        <ScrollViewer Height="419" VerticalScrollBarVisibility="Auto">
                                            <StackPanel x:Name="listaEnElaboracion"/>
                                        </ScrollViewer>
                                    </DockPanel>
                                </Border>

                                <!-- LISTOS -->
                                <Border Width="320" Padding="12" Margin="0,0,20,0" CornerRadius="12" BorderBrush="#CCCCCC" BorderThickness="1" Background="#FAFAFA">
                                    <DockPanel>
                                        <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Listos para entregar" FontSize="18" FontWeight="Bold"/>
                                            <Border Grid.Column="1" Background="#FF6B35" CornerRadius="10" Padding="8,2">
                                                <TextBlock Text="0" x:Name="txtNumListos" Foreground="White" FontWeight="Bold"/>
                                            </Border>
                                        </Grid>
                                        <ScrollViewer Height="420" VerticalScrollBarVisibility="Auto">
                                            <StackPanel x:Name="listaListos"/>
                                        </ScrollViewer>
                                    </DockPanel>
                                </Border>

                                <!-- HISTORIAL -->
                                <Border Width="320" Padding="12" CornerRadius="12" BorderBrush="#CCCCCC" BorderThickness="1" Background="#FAFAFA">
                                    <DockPanel>
                                        <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Historial" FontSize="18" FontWeight="Bold"/>
                                            <Border Grid.Column="1" Background="#FF6B35" CornerRadius="10" Padding="8,2">
                                                <TextBlock Text="0" x:Name="txtNumHistorial" Foreground="White" FontWeight="Bold"/>
                                            </Border>
                                        </Grid>
                                        <ScrollViewer Height="420" VerticalScrollBarVisibility="Auto">
                                            <StackPanel x:Name="listaHistorial"/>
                                        </ScrollViewer>
                                    </DockPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                    </Grid>
                </TabItem>

                <!-- TAB CLIENTES -->
                <TabItem x:Name="TabClientes" Background="Transparent">
                    <TabItem.Header>
                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                            <Image x:Name="ImgClientes" Height="64" Source="/imagenes/menuClientesOff.png"/>
                        </StackPanel>
                    </TabItem.Header>
                    <Grid Background="#FFFFFF" Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="69"/>
                            <RowDefinition Height="173"/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>


                        <!-- ===================== -->
                        <!--       PARTE ARRIBA    -->
                        <!-- ===================== -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="579*"/>
                                <ColumnDefinition Width="128*"/>
                            </Grid.ColumnDefinitions>
                            <Border Background="#F0F0F0"
        CornerRadius="10"
        Padding="8"
        Margin="10,12,9,15"
        Height="42">

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Icono -->
                                    <Image Source="imagenes/usuarioIcono.png"
               Height="22"
               Width="25"
               Margin="0,0,6,0"
               VerticalAlignment="Center"/>

                                    <!-- Buscador -->
                                    <TextBox x:Name="BuscadorClientes"
                 Grid.Column="1"
                 Height="26"
                 Background="Transparent"
                 BorderThickness="0"
                 VerticalAlignment="Center"
                 HorizontalAlignment="Stretch"
                 FontSize="14"/>
                                </Grid>
                            </Border>

                            <Button Padding="15,5" Cursor="Hand" Width="135" Click="Button_Click_3" Height="47" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,-7,0" Grid.ColumnSpan="2">
                                <Button.Template>
                                    <ControlTemplate TargetType="{x:Type Button}">
                                        <Border Background="#FFFF6B35" 
                                BorderBrush="LightGray" 
                                BorderThickness="2" 
                                CornerRadius="10">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Image Source="imagenes/usuarioIcono.png" Height="18" Margin="0 0 6 0"/>
                                    <TextBlock Text="Añadir Cliente" VerticalAlignment="Center" Foreground="White"/>
                                </StackPanel>
                            </Button>
                        </Grid>



                        <Border Margin="10,10,10,10" Grid.Row="1"
        Padding="15"
        Background="#F5F5F5"
        CornerRadius="12"
        BorderBrush="#D0D0D0"
        BorderThickness="1">

                            <Grid>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- CABECERA -->
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>

                                    <!-- TÍTULO -->
                                    <TextBlock Text="Clientes"
                       FontSize="18"
                       FontWeight="Bold"
                       VerticalAlignment="Center"/>

                                    <!-- SUBTÍTULO A LA DERECHA -->
                                    <TextBlock x:Name="TxtTotalClientes"
                       Grid.Column="1"
                       Foreground="Gray"
                       FontSize="14"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center">
                <Run Language="es-es" Text="0"/>
                <Run Text=" clientes registrados"/>
                                    </TextBlock>
                                </Grid>

                                <!-- SCROLL CON TARJETAS -->
                                <ScrollViewer Grid.Row="1"
                      Margin="0,10,0,0"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Disabled">

                                    <ItemsControl x:Name="ListaClientes">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>

                                        <!-- EJEMPLO 1 -->
                                        <Border Width="180" Height="55" Margin="5"
                        Background="White"
                        Padding="10"
                        CornerRadius="10"
                        BorderBrush="#E0E0E0"
                        BorderThickness="1">

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="45"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <Border Width="38" Height="38" CornerRadius="19" ClipToBounds="True" VerticalAlignment="Center">
                                                    <Image Source="/imagenes/perfil.png" Stretch="UniformToFill"/>
                                                </Border>

                                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="Juan Pérez" FontWeight="Bold" FontSize="14"/>
                                                    <TextBlock Text="666 555 444" FontSize="12" Foreground="Gray"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <!-- EJEMPLO 2 -->
                                        <Border Width="180" Height="55" Margin="5"
                        Background="White"
                        Padding="10"
                        CornerRadius="10"
                        BorderBrush="#E0E0E0"
                        BorderThickness="1">

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="45"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <Border Width="38" Height="38" CornerRadius="19" ClipToBounds="True" VerticalAlignment="Center">
                                                    <Image Source="/imagenes/perfil.png" Stretch="UniformToFill"/>
                                                </Border>

                                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="Ana García" FontWeight="Bold" FontSize="14"/>
                                                    <TextBlock Text="699 111 222" FontSize="12" Foreground="Gray"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <!-- EJEMPLO 3 -->
                                        <Border Width="180" Height="55" Margin="5"
Background="White"
Padding="10"
CornerRadius="10"
BorderBrush="#E0E0E0"
BorderThickness="1">

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="45"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <Border Width="38" Height="38" CornerRadius="19" ClipToBounds="True" VerticalAlignment="Center">
                                                    <Image Source="/imagenes/perfil.png" Stretch="UniformToFill"/>
                                                </Border>

                                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="Juan Pérez" FontWeight="Bold" FontSize="14"/>
                                                    <TextBlock Text="666 555 444" FontSize="12" Foreground="Gray"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <!-- EJEMPLO 4 -->
                                        <Border Width="180" Height="55" Margin="5"
Background="White"
Padding="10"
CornerRadius="10"
BorderBrush="#E0E0E0"
BorderThickness="1">

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="45"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <Border Width="38" Height="38" CornerRadius="19" ClipToBounds="True" VerticalAlignment="Center">
                                                    <Image Source="/imagenes/perfil.png" Stretch="UniformToFill"/>
                                                </Border>

                                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="Juan Pérez" FontWeight="Bold" FontSize="14"/>
