<Window x:Class="Lab_IPO1.CrearPlato"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Crear Plato" Height="500" Width="720"
        Background="White"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===================== IMAGEN DEL PLATO ======================= -->
        <Grid Grid.Column="0">
            <Border x:Name="ImgContainer"
                    Height="230" Width="230"
                    BorderBrush="#FFFF6B35" BorderThickness="2"
                    CornerRadius="10" HorizontalAlignment="Center"
                    VerticalAlignment="Top" Background="#FFE0E0E0">
                <Image x:Name="ImgPlato" Stretch="UniformToFill" OpacityMask="#FFE0E0E0"/>
            </Border>

            <!-- Botón elegir imagen -->
            <Button x:Name="BtnElegirImagen"
                    Content="Elegir imagen..."
                    Width="200" Height="35"
                    Background="#FFFF6B35"
                    Foreground="#E0E0E0"
                    FontWeight="Bold"
                    Margin="0,250,0,0"
                    HorizontalAlignment="Center"
                    Click="BtnElegirImagen_Click"
                    Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                BorderBrush="{TemplateBinding BorderBrush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- Botón de ayuda -->
            <Button Width="30" Height="30" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,-18,-427,0" Background="Transparent" Click="BtnAyuda_Click" Cursor="Hand">
                <Border CornerRadius="15" Background="#FFFF6B35">
                    <TextBlock Text="   ?" Foreground="White" FontWeight="Bold"
                               Width="25" Height="25" VerticalAlignment="Center"
                               HorizontalAlignment="Center" Margin="0,6,0,0"/>
                </Border>
            </Button>

            <!-- Error imagen -->
            <TextBlock x:Name="ErrorImagen" Text="Debes seleccionar una imagen."
                       Foreground="Red" FontSize="12" Visibility="Hidden"
                       HorizontalAlignment="Center" Margin="0,300,0,0"/>
        </Grid>

        <!-- ===================== CAMPOS ======================= -->
        <StackPanel Grid.Column="1" Margin="30,0,0,0" VerticalAlignment="Top" >

            <!-- Nombre -->
            <StackPanel x:Name="PanelNombre">
                <TextBlock Text="Nombre" FontWeight="Bold"/>
                <Border BorderBrush="#BFBFBF" BorderThickness="2" CornerRadius="8" Background="#E0E0E0">
                    <TextBox x:Name="TxtNombre" Background="Transparent" BorderThickness="0" Padding="5" />
                </Border>
                <TextBlock x:Name="ErrorNombre" Text="El nombre es obligatorio."
                           Foreground="Red" FontSize="12" Visibility="Hidden"/>
            </StackPanel>

            <!-- Precio -->
            <StackPanel x:Name="PanelPrecio">
                <TextBlock Text="Precio (€)" FontWeight="Bold"/>
                <Border BorderBrush="#BFBFBF" BorderThickness="2" CornerRadius="8" Background="#E0E0E0">
                    <TextBox x:Name="TxtPrecio" Background="Transparent" BorderThickness="0" Padding="5"/>
                </Border>
                <TextBlock x:Name="ErrorPrecio" Text="Precio inválido."
                           Foreground="Red" FontSize="12" Visibility="Hidden"/>
            </StackPanel>

            <!-- Categoría -->
            <StackPanel x:Name="PanelCategoria" Cursor="Hand">
                <TextBlock Text="Categoría" FontWeight="Bold"/>
                <Border BorderBrush="#BFBFBF" BorderThickness="2">
                    <ComboBox x:Name="ComboCategoria" Background="Transparent" BorderThickness="0" Padding="5"/>
                </Border>
                <TextBlock x:Name="ErrorCategoria" Text="Debes seleccionar una categoría."
                           Foreground="Red" FontSize="12" Visibility="Hidden"/>
            </StackPanel>

            <!-- Subcategoría -->
            <StackPanel x:Name="PanelSubcategoria" Cursor="Hand">
                <TextBlock Text="Subcategoría" FontWeight="Bold"/>
                <Border BorderBrush="#BFBFBF" BorderThickness="2">
                    <ComboBox x:Name="ComboSubcategoria" Background="Transparent" BorderThickness="0" Padding="5"/>
                </Border>
                <TextBlock x:Name="ErrorSubcategoria" Text="Debes seleccionar una subcategoría."
                           Foreground="Red" FontSize="12" Visibility="Hidden"/>
            </StackPanel>
            <TextBlock FontWeight="Bold"><Run Text="Ingredientes"/><Run Language="es-es" Text=" "/><Run Language="es-es" Text="(separados por comas)"/><Run Text=":"/></TextBlock>

            <!-- Ingredientes -->
            <Border CornerRadius="8" BorderBrush="Gray" BorderThickness="1" Background="#E0E0E0">
                <TextBox x:Name="TxtIngredientes" BorderThickness="0" Padding="4"
                         AcceptsReturn="True" TextWrapping="Wrap" Height="60" Background="Transparent"/>
            </Border>

            <!-- Alergenos -->
            <TextBlock FontWeight="Bold"><Run Text="Alergenos"/><Run Language="es-es" Text=" "/><Run Language="es-es" Text="(separados por comas)"/><Run Text=":"/></TextBlock>
            <Border CornerRadius="8" BorderBrush="Gray" BorderThickness="1" Background="#E0E0E0">
                <TextBox x:Name="TxtAlergenos" BorderThickness="0" Padding="4" Background="Transparent"/>
            </Border>

            <!-- ===================== BOTONES ======================= -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0" >

                <!-- Cancelar -->
                <Button x:Name="BtnCancelar"
                        Width="120" Height="40"
                        Background="#DDDDDD"
                        BorderThickness="0"
                        FontWeight="Bold"
                        Click="BtnCancelar_Click"
                        Cursor="Hand"
                        Content="Cancelar">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="10"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    BorderBrush="{TemplateBinding BorderBrush}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Crear -->
                <Button x:Name="BtnCrear"
                        Width="140" Height="40"
                        Background="#FFFF6B35"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="Bold"
                        Click="BtnCrear_Click"
                        Content="Crear"
                        Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="10"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    BorderBrush="{TemplateBinding BorderBrush}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
