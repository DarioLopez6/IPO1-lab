<Window x:Class="Lab_IPO1.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ajustes" Height="200" Width="300"
        Background="{DynamicResource WindowBackground}"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
        <Button x:Name="BtnLight" Content="Light" Width="100" Height="40" Click="BtnLight_Click"/>
        <Button x:Name="BtnDark" Content="Dark" Width="100" Height="40" Click="BtnDark_Click"/>
    </StackPanel>
</Window>
