<Window x:Class="Lab_IPO1.EditarPlato"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Plato" Height="450" Width="400" WindowStartupLocation="CenterOwner"
        Background="#f5f5f5" WindowStyle="None" AllowsTransparency="True">
    <Window.Resources>
        <Style TargetType="Button" x:Key="BotonRedondeado">
            <Setter Property="Background" Value="#FFFF6B35"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderBrush" Value="#FFFF6B35"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="5,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="BotonRedondeado2">
            <Setter Property="Background" Value="LightGray"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderBrush" Value="LightGray"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="5,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="White" CornerRadius="10" Padding="20" BorderBrush="#DDDDDD" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Nombre -->
            <TextBlock Text="Nombre:" Grid.Row="0" VerticalAlignment="Center" FontWeight="Bold"/>
            <TextBox x:Name="txtNombre" Grid.Row="0" Margin="120,5,0,5" Width="220" Height="25"/>

            <!-- Categoría -->
            <TextBlock Text="Categoría:" Grid.Row="1" VerticalAlignment="Center" FontWeight="Bold"/>
            <TextBox x:Name="txtCategoria" Grid.Row="1" Margin="120,5,0,5" Width="220" Height="25"/>

            <!-- Subcategoría -->
            <TextBlock Text="Subcategoría:" Grid.Row="2" VerticalAlignment="Center" FontWeight="Bold"/>
            <TextBox x:Name="txtSubcategoria" Grid.Row="2" Margin="120,5,0,5" Width="220" Height="25"/>

            <!-- Ingredientes -->
            <TextBlock Text="Ingredientes:" Grid.Row="3" VerticalAlignment="Top" FontWeight="Bold"/>
            <TextBox x:Name="txtIngredientes" Grid.Row="3" Margin="120,5,0,5" Width="220" Height="50" AcceptsReturn="True" TextWrapping="Wrap"/>

            <!-- Alérgenos -->
            <TextBlock Text="Alérgenos:" Grid.Row="4" VerticalAlignment="Top" FontWeight="Bold"/>
            <TextBox x:Name="txtAlergenos" Grid.Row="4" Margin="120,5,0,5" Width="220" Height="30" AcceptsReturn="True" TextWrapping="Wrap"/>

            <!-- Precio -->
            <TextBlock Text="Precio (€):" Grid.Row="5" VerticalAlignment="Center" FontWeight="Bold"/>
            <TextBox x:Name="txtPrecio" Grid.Row="5" Margin="120,5,0,5" Width="100" Height="25"/>

            <!-- Cantidad -->
            <TextBlock Text="Cantidad:" Grid.Row="6" VerticalAlignment="Center" FontWeight="Bold"/>
            <TextBox x:Name="txtCantidad" Grid.Row="6" Margin="120,5,0,5" Width="100" Height="25"/>

            <!-- Imagen -->
            <TextBlock Text="Imagen (ruta):" Grid.Row="7" VerticalAlignment="Top" FontWeight="Bold"/>
            <TextBox x:Name="txtImagen" Grid.Row="7" Margin="120,5,0,5" Width="220" Height="60" AcceptsReturn="True" TextWrapping="Wrap"/>

            <!-- Botones -->
            <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
                <Button Content="Aceptar" Style="{StaticResource BotonRedondeado}" Width="90" Height="30" Margin="5" Click="BtnAceptar_Click"/>
                <Button Content="Cancelar" Width="90" Height="30" Margin="5"
                        Style="{StaticResource BotonRedondeado2}" Click="BtnCancelar_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
