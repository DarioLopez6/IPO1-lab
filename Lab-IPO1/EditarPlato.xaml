<Window x:Class="Lab_IPO1.EditarPlato"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Editar Plato" Height="550" Width="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#FFF5F0">

    <Grid Margin="10">
        <!-- Border principal -->
        <Border CornerRadius="15" BorderBrush="#FFFF6B35" BorderThickness="2" Background="White" Padding="15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- Imagen + ayuda -->
                    <RowDefinition Height="*"/>
                    <!-- Info con scroll -->
                    <RowDefinition Height="Auto"/>
                    <!-- Botones -->
                </Grid.RowDefinitions>

                <!-- Imagen del plato con botón ayuda sobrepuesta -->
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Border Height="180" Background="#FFF5F0" CornerRadius="10">
                        <Image x:Name="ImgPlato" Stretch="UniformToFill"/>
                    </Border>

                    <!-- Botón de ayuda redondo sobre la imagen -->
                    <Button Width="30" Height="30" HorizontalAlignment="Right" VerticalAlignment="Top"
                            Margin="0,5,5,0" Background="Transparent" Click="BtnAyuda_Click" Cursor="Hand">
                        <Border CornerRadius="15" Background="#FFFF6B35">
                            <TextBlock Text="   ?" Foreground="White" FontWeight="Bold" Width="25" Height="25" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                        </Border>
                    </Button>
                </Grid>

                <!-- Información con scroll -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Orientation="Vertical">
                        <!-- Nombre -->
                        <TextBlock Text="Nombre:" FontWeight="Bold"/>
                        <Border CornerRadius="8" BorderBrush="Gray" BorderThickness="1" Background="#E0E0E0">
                            <TextBox x:Name="TxtNombre" BorderThickness="0" Padding="4" Background="Transparent" BorderBrush="#00ABADB3"/>
                        </Border>
                        <TextBlock x:Name="ErrNombre" Text="El nombre es obligatorio" Foreground="Red" Visibility="Hidden" Margin="0,2,0,5"/>


                        <!-- Categoría -->
                        <TextBlock Text="Categoría:" FontWeight="Bold"/>
                        <Border  BorderBrush="Gray" BorderThickness="1" Background="#E0E0E0">
                            <ComboBox x:Name="CmbCategoria" BorderThickness="0" Padding="4" Background="Transparent" BorderBrush="#00ACACAC">
                                <ComboBoxItem Content="Entrante"/>
                                <ComboBoxItem Content="Primero"/>
                                <ComboBoxItem Content="Segundo"/>
                                <ComboBoxItem Content="Postre"/>
                                <ComboBoxItem Content="Bebida"/>
                                <ComboBoxItem Content="Otro"/>
                            </ComboBox>
                        </Border>
                        <TextBlock x:Name="ErrCategoria" Text="La categoría es obligatoria" Foreground="Red" Visibility="Hidden" Margin="0,2,0,5"/>

                        <!-- Subcategoría -->
                        <TextBlock Text="Subcategoría:" FontWeight="Bold"/>
                        <Border  BorderBrush="Gray" BorderThickness="1" Background="#E0E0E0">
                            <ComboBox x:Name="CmbSubcategoria" BorderThickness="0" Padding="4" Background="Transparent">
                                <ComboBoxItem Content="Ensalada"/>
                                <ComboBoxItem Content="Carne"/>
                                <ComboBoxItem Content="Arroces y Pastas"/>
                                <ComboBoxItem Content="Pescado"/>
                                <ComboBoxItem Content="Otro"/>
                            </ComboBox>
                        </Border>
                        <TextBlock x:Name="ErrSubcategoria" Text="La subcategoría es obligatoria" Foreground="Red" Visibility="Hidden" Margin="0,2,0,5"/>


                        <!-- Ingredientes -->
                        <TextBlock Text="Ingredientes:" FontWeight="Bold"/>
                        <Border CornerRadius="8" BorderBrush="Gray" BorderThickness="1" Background="#E0E0E0">
                            <TextBox x:Name="TxtIngredientes" BorderThickness="0" Padding="4"
                                     AcceptsReturn="True" TextWrapping="Wrap" Height="60" Background="Transparent"/>
                        </Border>

                        <!-- Alergenos -->
                        <TextBlock Text="Alergenos:" FontWeight="Bold"/>
                        <Border CornerRadius="8" BorderBrush="Gray" BorderThickness="1" Background="#E0E0E0">
                            <TextBox x:Name="TxtAlergenos" BorderThickness="0" Padding="4" Background="Transparent"/>
                        </Border>

                        <!-- Precio -->
                        <TextBlock Text="Precio (€):" FontWeight="Bold"/>
                        <Border CornerRadius="8" BorderBrush="Gray" BorderThickness="1" Background="#E0E0E0">
                            <TextBox x:Name="TxtPrecio" BorderThickness="0" Padding="4" Background="Transparent"/>
                        </Border>
                        <TextBlock x:Name="ErrPrecio" Text="El precio es obligatorio" Foreground="Red" Visibility="Hidden" Margin="0,2,0,5"/>

                    </StackPanel>
                </ScrollViewer>

                <!-- Botones -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                    <!-- Guardar -->
                    <Border CornerRadius="10" Background="#DC3545">
                        <Button x:Name="BtnEliminar" Content="Eliminar" Width="120" Height="35"
                                Background="Transparent" Foreground="White" FontWeight="Bold"
                                Click="BtnEliminar_Click" BorderBrush="#00707070"/>
                    </Border>
                    <!-- Guardar -->
                    <Border CornerRadius="10" Background="#FFFF6B35">
                        <Button x:Name="BtnEditar" Content="Guardar" Width="120" Height="35" 
                                Background="Transparent" Foreground="White" FontWeight="Bold"
                                Click="BtnEditar_Click" BorderBrush="#00707070"/>
                    </Border>

                    <!-- Eliminar -->
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
